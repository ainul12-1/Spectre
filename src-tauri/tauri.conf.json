{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../ui",
    "distDir": "../ui",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Spectre",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "window": {
        "all": true
      },
      "shell": {
        "all": false,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "targets": ["nsis", "msi"],
      "identifier": "com.ainul.spectre",
      "copyright": "Copyright © 2024 Ainul",
      "category": "Utility",
      "shortDescription": "Spectre Stealth Safari Browser",
      "longDescription": "Spectre is a stealth Safari-style browser with cloth window physics and screen capture protection.",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Spectre",
        "width": 1180,
        "height": 780,
        "minWidth": 520,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ]
  }
}
